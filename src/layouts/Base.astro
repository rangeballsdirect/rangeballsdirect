---
import { site, countries } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = site.description, noindex = false } = Astro.props;

const origin = Astro.site ?? new URL('https://rangeballsdirect.com');
const base = import.meta.env.BASE_URL;

/** Join the deploy sub-path to a file in public/, without doubling the slash. */
const asset = (file: string) => (base.endsWith('/') ? base : `${base}/`) + file;

const canonical = new URL(Astro.url.pathname, origin).href;
const ogImage = new URL(asset('og.png'), origin).href;
const touchIcon = asset('apple-touch-icon.png');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: origin.href,
  email: site.email,
  description: site.description,
  areaServed: countries.map((name) => ({ '@type': 'Country', name })),
  contactPoint: [
    { '@type': 'ContactPoint', contactType: 'sales', email: site.email, availableLanguage: 'en' },
  ],
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="generator" content={Astro.generator} />
    {noindex
      ? <meta name="robots" content="noindex" />
      : <meta name="robots" content="index,follow,max-image-preview:large" />}

    <meta property="og:title" content={site.name} />
    <meta property="og:description" content={site.tagline} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="RangeBallsDirect — range balls, sourced direct." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={site.name} />
    <meta name="twitter:description" content={site.tagline} />
    <meta name="twitter:image" content={ogImage} />

    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='7' fill='%230a0a0a'/><circle cx='16' cy='16' r='7' fill='%23e4ff00'/></svg>"
    />
    <link rel="apple-touch-icon" href={touchIcon} />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
