---
import { balls } from '../data/balls';
---

<section class="range band" id="range">
  <div class="wrap">
  <header class="range__head">
    <p class="eyebrow">The range</p>
    <h2 class="h2">A ball for every tee line</h2>
  </header>

  <div class="range__rows">
    {balls.map((ball, i) => (
      <a class="row" href="#enquiry">
        <span class="row__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <span class="row__name">{ball.name}</span>
        <span class="row__blurb">{ball.blurb}</span>
        <span class="row__cta">Enquire →</span>
      </a>
    ))}
  </div>
  </div>
</section>

<style>
  .range {
    background: var(--bone);
    padding-block: 76px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .range__head { margin-bottom: 30px; }
  .range__head .eyebrow { margin: 0 0 12px; }

  .row {
    display: grid;
    grid-template-columns: 66px 1.3fr 1fr auto;
    gap: 24px;
    align-items: center;
    padding: 22px 12px;
    border-top: 1px solid var(--line);
    border-radius: 10px;
    text-decoration: none;
    color: var(--ink);
    transition: 0.15s;
  }

  .row:last-child { border-bottom: 1px solid var(--line); }

  .row:hover {
    background: var(--ink);
    color: #fff;
    padding-left: 22px;
    padding-right: 22px;
  }

  .row__num {
    font-weight: 700;
    font-size: 24px;
    letter-spacing: -0.02em;
    color: var(--ink);
    background: var(--pop);
    border-radius: 7px;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .row__name { font-weight: 700; font-size: 21px; letter-spacing: -0.02em; }

  .row__blurb { font-size: 13.5px; opacity: 0.62; }

  /*
   * The design had this in --pop, which is 1.1:1 against --bone and only legible
   * once :hover inverts the row. Ink at rest, accent once the row goes dark.
   */
  .row__cta { font-size: 13px; font-weight: 600; color: var(--ink); opacity: 0.62; transition: 0.15s; }
  .row:hover .row__cta, .row:focus-visible .row__cta { color: var(--pop); opacity: 1; }

  @media (max-width: 900px) {
    .row {
      grid-template-columns: 44px 1fr auto;
      gap: 14px;
      padding: 18px 8px;
    }

    /* Beats .row:hover, so a touch-held row cannot push the page sideways. */
    .row:hover { padding-left: 8px; padding-right: 8px; }

    .row__blurb { display: none; }
  }

  @media (max-width: 420px) {
    .row__name { font-size: 18px; }
  }
</style>
