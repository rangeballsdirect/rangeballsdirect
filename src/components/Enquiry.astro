---
import { site } from '../data/site';

// No form until there is somewhere for it to post. A form that silently
// swallows enquiries is worse than no form, so this routes straight to email.
const body = [
  'Range or course:',
  'Country:',
  'Ball type(s):',
  'Approx. volume per season:',
  'Anything else:',
].join('\n\n');

const mailto = `mailto:${site.email}?subject=${encodeURIComponent(site.enquirySubject)}&body=${encodeURIComponent(body)}`;
---

<section class="enquiry band" id="enquiry">
  <div class="wrap enquiry__grid">
    <div>
      <p class="eyebrow enquiry__eyebrow">Make an enquiry</p>
      <h2 class="h2 enquiry__title">Driving range ball requirements</h2>
      <p class="enquiry__body">
        Tell us what your range needs. We'll reply within one working day with options,
        specifications and pricing — no obligation, and always a named contact.
      </p>
      <div class="enquiry__member">
        <img
          src="/pga-members-crest-preview.png"
          alt="The Professional Golfers’ Association crest"
          width="96"
          height="91"
          loading="lazy"
        />
        <p>Carl is a member of The PGA.</p>
      </div>
    </div>

    <div class="panel">
      <p class="panel__label">Email us direct</p>
      <a class="panel__address" href={mailto}>{site.email}</a>
      <p class="panel__note">
        Include your range or course.
      </p>
      <a class="btn btn--pop panel__cta" href={mailto}>Send an enquiry →</a>
    </div>
  </div>
</section>

<style>
  .enquiry { padding-block: 82px; }

  .enquiry__grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 52px;
    align-items: center;
  }

  .enquiry__eyebrow { margin: 0 0 14px; }

  .enquiry__title { font-size: 48px; letter-spacing: -0.035em; line-height: 1; margin-bottom: 16px; }

  .enquiry__body {
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--muted);
    margin: 0;
    max-width: 38ch;
  }

  .enquiry__member {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 28px;
  }

  .enquiry__member img { width: 96px; height: auto; flex: none; }

  .enquiry__member p {
    margin: 0;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
  }

  .panel { background: var(--ink); border-radius: 18px; padding: 36px 32px; }

  .panel__label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    margin: 0 0 12px;
  }

  .panel__address {
    display: inline-block;
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--pop);
    text-decoration: none;
    line-height: 1.1;
    word-break: break-word;
    transition: 0.16s;
  }

  .panel__address:hover { color: #fff; }

  .panel__note {
    font-size: 14.5px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
    margin: 18px 0 0;
  }

  .panel__cta { margin-top: 26px; }

  @media (max-width: 900px) {
    .enquiry__grid { grid-template-columns: 1fr; gap: 28px; }
    .enquiry__title { font-size: 34px; }
    /* Padding, not just type size — the address is a tap target on a phone. */
    .panel__address { font-size: 23px; padding-block: 8px; }
    .panel__cta { width: 100%; }
  }

  @media (max-width: 420px) {
    .panel__address { font-size: 19px; }
  }
</style>
