---
import Wordmark from './Wordmark.astro';
import { nav, site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="wrap">
    <div class="foot__top">
      <Wordmark />
      <nav class="foot__links" aria-label="Footer">
        {nav.map(({ label, href }) => <a href={href}>{label}</a>)}
        <a class="foot__cta" href="#enquiry">Make an enquiry →</a>
      </nav>
    </div>
    <div class="foot__legal">
      <span>© {year} {site.name}</span>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </div>
</footer>

<style>
  .foot {
    background: var(--ink);
    color: rgba(255, 255, 255, 0.7);
    padding-block: 52px 38px;
    border-top: 1px solid var(--lined);
  }

  .foot__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
  }

  .foot__links {
    display: flex;
    gap: 26px;
    font-size: 13.5px;
    flex-wrap: wrap;
  }

  .foot__links a { text-decoration: none; transition: 0.16s; }
  .foot__links a:hover { color: var(--pop); }

  .foot__cta { color: var(--pop); font-weight: 600; }

  .foot__legal {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 26px;
    padding-top: 20px;
    border-top: 1px solid var(--lined);
    font-size: 11.5px;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.4);
  }

  .foot__legal a { text-decoration: none; }

  @media (max-width: 900px) {
    .foot__links a, .foot__legal a { padding: 11px 0; display: inline-block; }
  }
</style>
