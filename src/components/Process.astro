---
import { buying } from '../data/site';
---

<section class="buying band" id="delivery">
  <div class="wrap">
    <header class="buying__head">
      <p class="eyebrow buying__eyebrow">Buying from us</p>
      <h2 class="h2 buying__title">{buying.heading}</h2>
      <p class="buying__eyebrow buying__strapline">{buying.strapline}</p>
    </header>

    <div class="buying__grid">
      {buying.options.map(({ title, note }) => (
        <article class="buying__card">
          <h3 class="buying__card-title">{title}</h3>
          <p class="buying__card-note">{note}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .buying { background: var(--ink); color: #fff; padding-block: 76px; }

  .buying__head { max-width: 800px; margin-bottom: 34px; }
  .buying__eyebrow { color: var(--pop); margin: 0 0 12px; }
  .buying__title { font-size: 38px; line-height: 1.12; margin: 0 0 14px; color: #fff; }
  .buying__strapline { color: var(--pop); font-size: 20px; font-weight: 600; line-height: 1.3; margin: 0; }

  .buying__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  .buying__card { border: 1px solid var(--lined); border-radius: 16px; padding: 28px; }
  .buying__card-title { color: #fff; font-size: 23px; line-height: 1.15; margin: 0 0 14px; }
  .buying__card-note { color: rgba(255, 255, 255, 0.7); font-size: 15px; line-height: 1.6; margin: 0; max-width: 52ch; }

  @media (max-width: 900px) {
    .buying__title { font-size: 30px; }
  }

  @media (max-width: 640px) {
    .buying__grid { grid-template-columns: 1fr; }
    .buying__card { padding: 22px; }
  }

  @media (max-width: 420px) {
    .buying__title { font-size: 27px; }
  }
</style>
