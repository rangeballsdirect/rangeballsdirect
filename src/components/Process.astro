---
import { process } from '../data/site';
---

<section class="process band" id="delivery">
  <div class="wrap">
    <h2 class="h2 process__title">From your order to your range</h2>
    <ol class="process__grid">
      {process.map(({ step, title, note }) => (
        <li class="step">
          <div class="step__num" aria-hidden="true">{step}</div>
          <h3 class="step__title">{title}</h3>
          <p class="step__note">{note}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process { background: var(--ink); color: #fff; padding-block: 76px; }

  /*
   * The one heading that carries default leading rather than the shared 1.02.
   * It is the only h2 that wraps to two lines on a phone, where 1.02 collides.
   */
  .process__title { font-size: 38px; line-height: normal; margin-bottom: 40px; color: #fff; }

  .process__grid {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .process__grid::before {
    content: '';
    position: absolute;
    left: 27px;
    top: 28px;
    bottom: 28px;
    width: 1px;
    background: rgba(255, 255, 255, 0.24);
  }

  .step {
    position: relative;
    display: grid;
    grid-template-columns: 56px minmax(170px, 0.7fr) minmax(0, 1fr);
    align-items: center;
    gap: 24px;
    padding: 18px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  .step:last-child { border-bottom: 1px solid rgba(255, 255, 255, 0.14); }

  .step__num {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--pop);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: -0.02em;
    color: var(--ink);
    line-height: 1;
  }

  .step__title { font-size: 19px; font-weight: 600; letter-spacing: normal; margin: 0; color: #fff; }

  .step__note { max-width: 56ch; font-size: 15px; line-height: 1.55; color: rgba(255, 255, 255, 0.7); margin: 0; }

  @media (max-width: 900px) {
    .process__title { font-size: 30px; }
  }

  @media (max-width: 640px) {
    .step { grid-template-columns: 56px minmax(0, 1fr); gap: 4px 18px; padding: 20px 0; }
    .step__num { grid-row: span 2; }
    .step__title { font-size: 17px; }
    .step__note { grid-column: 2; font-size: 14px; }
  }

  @media (max-width: 420px) {
    .process__title { font-size: 27px; }
  }
</style>
