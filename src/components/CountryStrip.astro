---
import { countries } from '../data/site';
---

<div class="strip">
  <span class="strip__label">On the tee line in</span>
  <div class="strip__list">
    {countries.map((country, i) => (
      <>
        {i > 0 && <span aria-hidden="true">·</span>}
        <span>{country}</span>
      </>
    ))}
  </div>
</div>

<style>
  .strip {
    border-top: 1px solid var(--lined);
    padding: 17px var(--pad);
    display: flex;
    align-items: center;
    gap: 16px 30px;
    flex-wrap: wrap;
  }

  .strip__label {
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
    white-space: nowrap;
  }

  .strip__list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 26px;
    font-size: 13px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.6);
  }
</style>
