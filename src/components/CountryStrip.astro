---
const countries = [
  { name: 'Deutschland', flag: '🇩🇪' },
  { name: 'Austria', flag: '🇦🇹' },
  { name: 'Switzerland', flag: '🇨🇭' },
];
---

<div class="stripband">
  <div class="strip wrap">
    <span class="strip__label">On the tee line in</span>
    <div class="strip__list">
      {countries.map(({ name, flag }, i) => (
        <>
          {i > 0 && <span aria-hidden="true">–</span>}
          <span class="strip__country"><span class="strip__flag" aria-hidden="true">{flag}</span>{name}</span>
        </>
      ))}
    </div>
  </div>
</div>

<style>
  .stripband { border-top: 1px solid var(--lined); }

  .strip {
    padding-block: 17px;
    display: flex;
    align-items: center;
    gap: 16px 30px;
    flex-wrap: wrap;
  }

  .strip__label {
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
    white-space: nowrap;
  }

  .strip__list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 26px;
    font-size: 13px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.6);
  }

  .strip__country {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .strip__flag { font-size: 16px; line-height: 1; }
</style>
