---
import Base from '../layouts/Base.astro';
import Wordmark from '../components/Wordmark.astro';

const home = import.meta.env.BASE_URL;
---

<Base title="Page not found — RangeBallsDirect" noindex>
  <main class="nf" id="main">
    <div class="nf__wrap">
      <Wordmark />
      <p class="nf__code">Error 404</p>
      <h1 class="nf__title">That one sailed<br />over the net<span class="nf__stop">.</span></h1>
      <p class="nf__body">
        The page you were after doesn't exist. Head back to the range — everything else is still
        on the tee line.
      </p>
      <a class="btn btn--pop" href={home}>Back to the range →</a>
    </div>
  </main>
</Base>

<style>
  .nf {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px;
    background: var(--ink);
    color: #fff;
  }

  .nf__wrap { max-width: 520px; }
  .nf__wrap :global(.mark) { margin-bottom: 34px; }

  .nf__code {
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--pop);
    margin: 0 0 20px;
  }

  .nf__title {
    font-weight: 700;
    font-size: 56px;
    line-height: 0.99;
    letter-spacing: -0.035em;
    margin: 0 0 18px;
  }

  .nf__stop { color: var(--pop); }

  .nf__body {
    font-size: 17px;
    line-height: 1.58;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.7);
    margin: 0 0 30px;
  }

  @media (max-width: 520px) {
    .nf__title { font-size: 40px; }
    .nf__body { font-size: 15.5px; }
  }
</style>
